# ---------------------------------------------------------------------------
# Game assets MUST NEVER be committed to this repository.
# This project documents formats; it does not redistribute content.
# ---------------------------------------------------------------------------
extract/
game/
# ...but `web/src/game/` is the browser player's port of the gameplay code, not
# a copy of the game. Named for what it is a port of; excluded from the rule
# above by path, so the rule itself stays as broad as it was.
!web/src/game/
*.bin
*.exe
*.dll
*.wav
*.pvr
*.pvp
*.pal
*.png
*.bmp
*.tga
*.gltf
*.glb

# Explicit allowance (generated metadata, no asset content)
!manifest.csv

# Web player
# The client's source is committed; nothing it consumes or produces is.
# `extract/player/` is game-derived data and is already covered by `extract/`
# above -- it is named again here because it is the one directory a reader is
# most likely to be tempted to commit.
extract/player/
web/node_modules/
web/dist/
web/.vite/
web/test-results/
web/playwright-report/

# Ghidra
# Project databases and analysis output are local; the scripts that produce
# them are committed, because reproducibility is the point.
*.gpr
*.rep/
ghidra/project/
ghidra/out/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Local-only screenshots of the running player. A screenshot of a stage is
# derived game art, and no game asset or anything derived from one is ever
# committed: checks assert against hashes and derived numbers instead.
web/shots/

# Agent worktrees. `.claude/worktrees/<id>/` is a full checkout each, made by
# the tooling and thrown away with it -- repo scratch, not repo content.
.claude/worktrees/

# The matchmaker's secrets: the Cloudflare TURN key and its API token, as
# `wrangler dev` reads them, and the API token `wrangler` deploys with
# (docs/PLAYER.md, "The matchmaker"). Never committed.
.dev.vars
.dev.vars.*
.cloudflare.env
# The site deploy's settings and secret path (`r2site/`, `web/tools/deploy.ts`).
.deploy.env
# wrangler's own cache, written beside wrangler.toml by every deploy.
.wrangler/

