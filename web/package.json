{
  "name": "hod2-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser stage player for The House of the Dead 2, driven by the game's own event script.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test:port": "node --experimental-strip-types --no-warnings tools/run_test.mjs test/port.test.ts",
    "replay": "node --experimental-strip-types --no-warnings tools/run_test.mjs tools/replay.mjs",
    "test:seek": "node --experimental-strip-types --no-warnings tools/run_test.mjs test/seek.test.ts",
    "test:scope": "node --experimental-strip-types --no-warnings tools/run_test.mjs test/scope.test.ts",
    "test:state": "node --experimental-strip-types --no-warnings tools/run_test.mjs test/state.test.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
