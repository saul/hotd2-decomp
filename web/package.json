{
  "name": "hod2-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser stage player for The House of the Dead 2, driven by the game's own event script.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test:port": "node tools/run_test.mjs test/port.test.ts",
    "test:bundle": "node tools/run_test.mjs test/bundle.test.ts",
    "replay": "node tools/run_test.mjs tools/replay.mjs",
    "test:seek": "node tools/run_test.mjs test/seek.test.ts",
    "test:scope": "node tools/run_test.mjs test/scope.test.ts",
    "test:pose": "node tools/run_test.mjs test/pose.test.ts",
    "test:render": "node tools/run_test.mjs test/render.test.ts",
    "test:state": "node tools/run_test.mjs test/state.test.ts",
    "test:ui": "node tools/run_test.mjs test/ui.test.tsx",
    "test:projection": "node tools/run_test.mjs test/projection.test.ts",
    "test:camera": "node tools/run_test.mjs test/camera.test.ts",
    "verify:ui": "node tools/verify_ui.mjs",
    "shot": "node tools/shot.mjs",
    "pacing": "node tools/pacing.mjs",
    "entrances": "node tools/run_test.mjs tools/entrances.mjs",
    "cam-cues": "node tools/run_test.mjs tools/cam_cues.mjs",
    "leaps": "node tools/run_test.mjs tools/leaps.mjs",
    "lifetime": "node tools/run_test.mjs tools/lifetime.mjs",
    "test:texfilter": "node tools/run_test.mjs test/texfilter.test.ts",
    "lookat": "node tools/lookat_live.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.169.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
